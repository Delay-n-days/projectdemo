<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectManager.UI.ViewModels"
        x:Class="ProjectManager.UI.Views.SaveAsDialog"
        x:DataType="vm:SaveAsViewModel"
        Width="600" Height="250"
        Title="另存为项目"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <!-- 表单内容 -->
        <StackPanel Grid.Row="0" Spacing="15">
            <TextBlock Text="另存为新项目" FontSize="16" FontWeight="Bold"/>
            
            <!-- 项目名称 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Grid.Column="0" Text="项目名称:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ProjectName}" Watermark="请输入项目名称"/>
            </Grid>

            <!-- 项目路径 -->
            <Grid ColumnDefinitions="100,*,Auto">
                <TextBlock Grid.Column="0" Text="保存路径:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ProjectPath}" Watermark="请选择保存位置"/>
                <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseCommand}" 
                        Padding="15,5" Margin="10,0,0,0"/>
            </Grid>

            <!-- 完整路径预览 -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Padding="10" Background="#F5F5F5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="项目将保存到:" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="{Binding FullPath}" FontFamily="Consolas" Margin="0,5,0,0"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}" Padding="20,8" IsDefault="True"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
